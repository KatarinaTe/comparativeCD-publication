process {

    resourceLimits = [
        cpus:   24,
        memory: 128.GB,
        time:   96.h
    ]

    withLabel: process_single {
        cpus   = 1
        memory = { 2.GB * task.attempt }
        time   = { 1.h  * task.attempt }
    }

    withLabel: process_low {
        cpus   = 2
        memory = { 4.GB  * task.attempt }
        time   = { 4.h   * task.attempt }
    }

    withLabel: process_medium {
        cpus   = 6
        memory = { 16.GB * task.attempt }
        time   = { 12.h  * task.attempt }
    }

    withLabel: process_high {
        cpus   = 12
        memory = { 64.GB * task.attempt }
        time   = { 48.h  * task.attempt }
    }

    errorStrategy = {
        task.exitStatus in [104, 110, 137, 139, 143] && task.attempt <= 3
            ? 'retry'
            : 'finish'
    }
    maxRetries = 3

    // bwa-mem2==2.1 (pinned to match the manuscript's stated version) has a confirmed,
    // intermittent upstream race condition in its multi-threaded SMEM-reallocation code
    // (bwa-mem2/bwa-mem2#88, "Shringking not supported yet" / "Re-allocating SMEM data
    // structures due to enc_qdb" -> munmap_chunk(): invalid pointer / malloc corruption).
    // Fixed in a commit shortly after the v2.1 tag, but bwa-mem2 has had no release since,
    // so the pinned conda/bioconda build still carries it. Not data- or logic-dependent --
    // multiple independent reports show the identical command on identical input sometimes
    // crashing and sometimes not, so a retry has a real chance of not hitting the same
    // thread-timing window twice. With this process's `pipefail` shell option, the crash
    // surfaces as exit 1 (samtools view failing to parse bwa-mem2's truncated output), not
    // bwa-mem2's own would-be abort exit code -- confirmed 2026-09-23 running the real batched
    // mapping pipeline on Pelle (SRR30354483:run_31001806033749, batch_03).
    withName: 'DOG10K_MAPPING' {
        errorStrategy = {
            task.exitStatus in [1, 104, 110, 137, 139, 143] && task.attempt <= 3
                ? 'retry'
                : 'finish'
        }
        maxRetries = 3
        // SRR30355159:run_31019073909128 (batch_06) hit the #88 race on 3 separate retries in
        // each of two independent full pipeline runs (2026-09-27 and 2026-09-28) -- exit 139
        // once, exit 1/samtools-parse-error the other five times. Retrying alone isn't reliably
        // clearing this specific sample's timing window at 12 threads. Dropping to 8 narrows
        // that window while keeping most of the throughput of 12; applied to every DOG10K_MAPPING
        // task (not just this sample) so every batch in the rerun uses identical settings.
        cpus = 8
    }
}
