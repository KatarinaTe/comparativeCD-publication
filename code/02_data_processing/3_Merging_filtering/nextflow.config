params {
    // 01_mapping's merged LowPass PLINK dataset (path prefix, no extension)
    gencove_bfile_prefix = null

    // 2_Axiom_imputation's merged, imputed PLINK dataset (path prefix, no extension)
    axiom_bfile_prefix = null

    // Frozen inputs (data/02_data_processing) — see the pipeline README for what each preserves
    fam_qc3modi         = null // DA_MERGED_GENCOVE_AXIOM_QC3modi.fam
    depth_file          = null // DarwinsDogs_N-3285_bam_meandepths.txt
    duplicates_file     = null // Duplicates_to_keep_DarwinsDogs_N-9_21samples_bam_meandepths.txt
    exclude_list_round2 = null // list_exclude_secondexclusion.txt (manual KING-based decision)
    dogid_relabel_fam   = null // modi_DA_MERGED_GENCOVE_AXIOM_QC4C_forDogIDchange.fam (manual)
    exclude_list_round3 = null // list_exclude_thirdexclusion.txt (manual)
    covariates          = null // DarwinsDogs_Q121_height_age_sex_batch_GENCOVE_AXIOM_QC4.tsv
    fam_2584dogs        = null // fam_2584dogs.txt (manual final-sample-set decision)
    data6               = null // data6_2024-10-14.txt (frozen checkpoint, see Stage E notes)

    // 12 LowPass samples with no Darwin's Ark dogID and no phenotypes, removed in
    // RELABEL_AND_EXCLUDE_ROUND3.
    exclude_list_lowpass12 = null // exclude_12_LowPass_samples.txt (data/01_mapping)

    // Not part of the original 01/02/03/04 sources for this pipeline — see
    // process_definitions.nf's SIZE section header. Darwin's Ark's own SIZE phenotype
    // (data/04_gwas/getSIZE_pheno_genofiles.r); not in this repo.
    size_pheno_file = null // Q121A.pheno
}

plugins {
    id 'nf-schema@2.7.2'
}

// Matches nf-core template — fail fast on errors.
process.shell = [
    'bash',
    '-C',         // No clobber — prevent output redirection from overwriting files
    '-e',         // Exit if a tool returns a non-zero status/exit code
    '-u',         // Treat unset variables and parameters as an error
    '-o',         // Returns the status of the last command to exit...
    'pipefail'    //   ...with a non-zero status or zero if all successfully execute
]

includeConfig 'conf/base.config'

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${projectDir}/../../../env/apptainer_cache"
    }

    conda {
        conda.enabled = true
    }

    slurm {
        executor.name      = 'slurm'
        executor.queueSize = 100
    }

    // UPPMAX: Rackham
    uppmax {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/uppmax.config'
    }

    // PDC-KTH: Dardel
    dardel {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/pdc_kth.config'
    }
}
