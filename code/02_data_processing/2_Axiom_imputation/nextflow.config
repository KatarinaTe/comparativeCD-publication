params {
    // Raw Axiom array genotypes (canFam3), as a plink bfile prefix (no extension)
    axiom_bfile_prefix = null

    // 411 Darwin's Ark Axiom samples to keep
    ind_to_keep = null

    // UCSC liftOver chain: canFam3 -> canFam4
    liftover_chain = null

    // Reference genome (UU_Cfam_GSD_1.0) — .fai must be co-located with the FASTA
    assembly_ref = null

    // GLIMPSE imputation reference panel (Dog10K phased) — .csi must be co-located with the .bcf
    glimpse_ref_panel = null

    // Per-chromosome [chr, start, stop] regions (data/02_data_processing/cf4_chr_start_stop.bed)
    chr_start_stop = null

    // Numeric-to-"chrN" chromosome rename map (data/02_data_processing/chromosomes.txt)
    chr_rename_map = null

    // Directory of per-chromosome genetic maps (data/02_data_processing/mapfiles)
    genetic_maps_dir = null

    // conform-gt and beagle jars — fetch with: pixi run fetch-axiom-jars
    conform_gt_jar = null
    beagle_jar     = null
}

plugins {
    id 'nf-schema@2.7.2'
}

// Matches nf-core template — fail fast on errors.
process.shell = [
    'bash',
    '-C',         // No clobber — prevent output redirection from overwriting files
    '-e',         // Exit if a tool returns a non-zero status/exit code
    '-u',         // Treat unset variables and parameters as an error
    '-o',         // Returns the status of the last command to exit...
    'pipefail'    //   ...with a non-zero status or zero if all successfully execute
]

includeConfig 'conf/base.config'

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${projectDir}/../../../env/apptainer_cache"
    }

    conda {
        conda.enabled = true
    }

    slurm {
        executor.name      = 'slurm'
        executor.queueSize = 100
    }

    // UPPMAX: Rackham
    uppmax {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/uppmax.config'
    }

    // PDC-KTH: Dardel
    dardel {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/pdc_kth.config'
    }
}
