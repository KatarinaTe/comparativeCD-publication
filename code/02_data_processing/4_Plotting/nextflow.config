params {
    // 3_Merging_filtering's ALLFAM PCA outputs (Stage D)
    eigenvec = null // prunedALLFAM_DA_MERGED_GENCOVE_AXIOM_QC6.eigenvec
    eigenval = null // prunedALLFAM_DA_MERGED_GENCOVE_AXIOM_QC6.eigenval

    // Frozen phenotype checkpoint, same file 3_Merging_filtering consumes (data/02_data_processing)
    data6 = null // data6_2024-10-14.txt

    // Per-dog breed/purebred metadata (data/02_data_processing/DarwinsArk_20220715_dogs_genotyped_breed_sex.csv) —
    // the original reads this from a literal placeholder path, scrubbed before the script was
    // committed. See PLOT_PCA's header comment.
    dog_breeds_csv = null

    // Directory containing 3_Merging_filtering's published per-factor/per-item QC6 fam files
    // (CCDF{1,2,3}_DA_MERGED_GENCOVE_AXIOM_QC6.fam, CCDitem{N}_DA_MERGED_GENCOVE_AXIOM_QC6.fam) —
    // that pipeline's `plink/` output directory.
    qc6_fam_dir = null
}

plugins {
    id 'nf-schema@2.7.2'
}

// Matches nf-core template — fail fast on errors.
process.shell = [
    'bash',
    '-C',         // No clobber — prevent output redirection from overwriting files
    '-e',         // Exit if a tool returns a non-zero status/exit code
    '-u',         // Treat unset variables and parameters as an error
    '-o',         // Returns the status of the last command to exit...
    'pipefail'    //   ...with a non-zero status or zero if all successfully execute
]

includeConfig 'conf/base.config'

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${projectDir}/../../../env/apptainer_cache"
    }

    conda {
        conda.enabled = true
    }

    slurm {
        executor.name      = 'slurm'
        executor.queueSize = 100
    }

    // UPPMAX: Rackham
    uppmax {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/uppmax.config'
    }

    // PDC-KTH: Dardel
    dardel {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/pdc_kth.config'
    }
}
