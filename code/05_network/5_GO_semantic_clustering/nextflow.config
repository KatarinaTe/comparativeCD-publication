params {
    // Real GO enrichment TSVs (data/05_network/) — these are what elinors_analysis/'s own
    // scripts should read via "../Figure4/<file>.tsv", a relative path that does not exist
    // anywhere in this repo. See process_definitions.nf / archive/conversion_notes/
    // 05_network.md for the staging fix.
    dep_only_go = null
    dep_ccd_go  = null
    ocd_only_go = null
    ocd_ccd_go  = null
    sch_only_go = null
    sch_ccd_go  = null
    dogcd_go    = null  // dogCD: single-species, dog-only GO enrichment (no run1/run2 pair)

    // Frozen inputs already checked into data/05_network/5_GO_semantic_clustering/elinors_analysis/
    // — not built by any pipeline.
    cache_gpt_labels = null
    goa_human_gaf    = null
    seed_genes_csv   = null

    // Elinor's own, unedited scripts (never modified — read-only collaborator source).
    script_semantic_clustering         = null
    script_plot_go_clusters            = null
    script_ocd_na_detail                = null
    script_plot_fold_enrichment         = null
    script_gene_enrichment_grids        = null
    script_gene_enrichment_grids_v2     = null
    script_genes_for_multiple_terms     = null

    // Satisfies 01_semantic_clustering.R's unconditional `Sys.getenv("OPENAI_API_KEY") == ""`
    // check. The frozen cache_gpt_labels file already covers every cut60 cluster, so no real
    // API call is expected to fire against a clean rerun of the frozen inputs above — a real
    // key is only needed if the semantic-clustering step (recomputed fresh every run; its own
    // .rds cache is not checked in) produces cluster IDs the frozen cache doesn't cover. See
    // archive/conversion_notes/05_network.md.
    openai_api_key = 'unused-frozen-cache-only'
}

plugins {
    id 'nf-schema@2.7.2'
}

// Matches nf-core template — fail fast on errors.
process.shell = [
    'bash',
    '-C',         // No clobber — prevent output redirection from overwriting files
    '-e',         // Exit if a tool returns a non-zero status/exit code
    '-u',         // Treat unset variables and parameters as an error
    '-o',         // Returns the status of the last command to exit...
    'pipefail'    //   ...with a non-zero status or zero if all successfully execute
]

includeConfig 'conf/base.config'

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${projectDir}/../../../env/apptainer_cache"
    }

    conda {
        conda.enabled = true
    }

    slurm {
        executor.name      = 'slurm'
        executor.queueSize = 100
    }

    // UPPMAX: Rackham
    uppmax {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/uppmax.config'
    }

    // PDC-KTH: Dardel
    dardel {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/pdc_kth.config'
    }
}
