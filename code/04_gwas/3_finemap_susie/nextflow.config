params {
    // 3_Merging_filtering's published plink/ dir (holds both QC5 and QC6 files)
    qc6_plink_dir = null // DA_MERGED_GENCOVE_AXIOM_QC5.{bed,bim,fam}

    // 1_mlma-loco / 2_polmm's published sumstats/ dirs
    mlma_sumstats_dir  = null // CCD{F1,F2,F3}_sumstats.txt
    polmm_sumstats_dir = null // ITEM{N}_sumstats.txt
    size_sumstats_dir  = null // 1_mlma-loco's sumstats/size/ subdir — SIZE_sumstats.txt

    // Deposited raw data files (not built by any pipeline) — data/04_gwas/
    size_fam   = null // SIZE_DA_MERGED_GENCOVE_AXIOM_QC6.fam
    stuck_fam  = null // STUCK_DA_MERGED_GENCOVE_AXIOM_QC6.fam
    allfam_fam = null // ALLFAM_DA_MERGED_GENCOVE_AXIOM_QC6.fam
}

plugins {
    id 'nf-schema@2.7.2'
}

// Matches nf-core template — fail fast on errors.
process.shell = [
    'bash',
    '-C',         // No clobber — prevent output redirection from overwriting files
    '-e',         // Exit if a tool returns a non-zero status/exit code
    '-u',         // Treat unset variables and parameters as an error
    '-o',         // Returns the status of the last command to exit...
    'pipefail'    //   ...with a non-zero status or zero if all successfully execute
]

includeConfig 'conf/base.config'

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${projectDir}/../../../env/apptainer_cache"
    }

    conda {
        conda.enabled = true
    }

    slurm {
        executor.name      = 'slurm'
        executor.queueSize = 100
    }

    // UPPMAX: Rackham
    uppmax {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/uppmax.config'
    }

    // PDC-KTH: Dardel
    dardel {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/pdc_kth.config'
    }
}
