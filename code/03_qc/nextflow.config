params {
    // Reference genome (UU_Cfam_GSD_1.0) — same reference used by 01_mapping.
    // Index files (.fai, .dict, bwa-mem2 indices) must be co-located with the FASTA.
    // .tbi indices must be co-located with their .bed.gz / .vcf.gz files.
    assembly_ref   = null
    known_variants = null
    chunks_dir     = null

    // GLIMPSE imputation reference panel (Dog10K phased) — same panel used by 01_mapping.
    // .csi index must be co-located with the .bcf file.
    glimpse_ref_panel = null

    // ── Study 1/3 inputs: HighPass cohort ───────────────────────────────────
    // Jointly-called, hard-filtered HighPass SNP VCF — published by 01_mapping as
    // highpass/snp_vcf/SNP.HF.ann.id.vcf.gz. .tbi index must be co-located.
    highpass_snp_vcf = null
    // Directory of per-sample HighPass BAMs — published by 01_mapping as highpass/bam/,
    // named <sample_id>.sorted.merged.MarkDups.BQSR.bam(.bai).
    highpass_bam_dir = null

    // ── Study 1/2 inputs: LowPass cohort ────────────────────────────────────
    // Directory of per-chromosome, QC-filtered LowPass VCFs — published by 01_mapping
    // as lowpass/vcf/DA.<chr>.merged.qc_modi.vcf.gz.
    lowpass_qc_vcf_dir = null

    // ── Study 2 input: Axiom-array cohort ───────────────────────────────────
    // Directory of per-chromosome Axiom-imputed VCFs. Produced by 02_data_processing
    // (not yet converted to Nextflow) — supply the path to wherever those files land.
    axiom_lowpass_vcf_dir = null

    // ── Sample lists and pair samplesheets ───────────────────────────────────
    samples_highpass_11              = null
    samples_downsampling_10          = null
    downsample_p_at_1x               = null
    concordance_highpass_lowpass_pairs = null
    concordance_axiom_lowpass_pairs    = null
}

plugins {
    id 'nf-schema@2.7.2'
}

// Matches nf-core template — fail fast on errors.
process.shell = [
    'bash',
    '-C',         // No clobber — prevent output redirection from overwriting files
    '-e',         // Exit if a tool returns a non-zero status/exit code
    '-u',         // Treat unset variables and parameters as an error
    '-o',         // Returns the status of the last command to exit...
    'pipefail'    //   ...with a non-zero status or zero if all successfully execute
]

includeConfig 'conf/base.config'

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    apptainer {
        apptainer.enabled    = true
        apptainer.autoMounts = true
        apptainer.cacheDir   = "${projectDir}/../../env/apptainer_cache"
    }

    conda {
        conda.enabled = true
    }

    slurm {
        executor.name      = 'slurm'
        executor.queueSize = 100
    }

    // UPPMAX: Rackham
    uppmax {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/uppmax.config'
    }

    // PDC-KTH: Dardel
    dardel {
        includeConfig 'https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/pdc_kth.config'
    }
}
