resume = true
// Default only — analyses/00_fetch-raw-data/run_batched.sh overrides this per batch
// via nextflow run's own `-output-dir` CLI flag, so each batch's raw (pre-materialized)
// output lands in its own directory rather than overwriting the previous batch's.
outputDir = '../../../data/results/01_mapping/1_fetch_map/default'

profiles {
    stub_test {
        // profile to run stub test
        // export NXF_PROFILE=stub_test
        // pixi run fetch-map -stub
        resume = true
        executor {
            name = 'local'
        }
        docker.enabled = true
        process {
            resourceLimits = [
                cpus: 10,
                memory: 64.GB
            ]
        }
    }
}

// This configuration file can be used to override resource settings
// such as cpus, memory, time, or any other process directive.
// e.g.
// process {
//     withName: 'PROCESS_NAME' {
//         cpus = 20
//         memory = 50.GB
//     }
// }
