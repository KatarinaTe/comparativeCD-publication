resume = true

profiles {
    test_one_sample {
        // export NXF_PROFILE=test_one_sample
        // pixi run fetch-raw-data
        executor {
            name = 'local'
        }
        docker.enabled = true
        process {
            resourceLimits = [
                cpus: 10,
                memory: 64.GB
            ]
        }
    }

    apptainer {
        // Default profile: run locally within a single full-node SLURM
        // allocation on Pelle (see run_nextflow.sh) instead of submitting
        // one SLURM job per task, avoiding lost job tracking.
        // Node/container settings mirrored from nf-core/configs:
        // https://github.com/nf-core/configs/blob/master/conf/uppmax/pelle.config
        executor {
            name = 'local'
        }
        apptainer.enabled     = true
        apptainer.autoMounts  = true
        apptainer.runOptions  = '-B $SNIC_TMP'
        apptainer.envWhitelist = 'SNIC_TMP'
        // No local main script here (this pipeline runs nf-core/fetchngs, a remote pipeline, not
        // a local .nf file), so ${projectDir} isn't repo-local — ${launchDir} is used instead,
        // relying on run_nextflow.sh's own anchor to the submission directory (analyses/00_fetch-raw-data/).
        apptainer.cacheDir    = "${launchDir}/../../env/apptainer_cache"
        process {
            resourceLimits = [
                cpus: 96,
                memory: 750.GB,
                time: 5.d
            ]
        }
    }
}

process {
    withName: 'SRATOOLS_PREFETCH' {
        ext.args = '--max-size 250G'
    }
}