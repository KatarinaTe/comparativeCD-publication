resume = true
outputDir = '../../../data/results/07_additional_plots_and_analyses/5_cross_species_transcriptomic_heatmap'

profiles {
    stub_test {
        // profile to run stub test
        // export NXF_PROFILE=stub_test
        // pixi run 07g-cross-species-transcriptomic-heatmap -stub
        resume = true
        executor {
            name = 'local'
        }
        docker.enabled = true
        process {
            resourceLimits = [
                cpus: 10,
                memory: 64.GB
            ]
        }
    }
}

// This configuration file can be used to override resource settings
// such as cpus, memory, time, or any other process directive.
// e.g.
// process {
//     withName: 'PROCESS_NAME' {
//         cpus = 20
//         memory = 50.GB
//     }
// }
